import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

export async function createRequest(requestData) {
    console.log("createRequest called:", requestData);

    const token = await getSecret("AIRTABLE_TOKEN");
    const baseId = await getSecret("AIRTABLE_BASE_ID");

    console.log("Token exists:", !!token);
    console.log("Base ID:", baseId);

    const response = await fetch(
        `https://api.airtable.com/v0/${baseId}/Requests`,
        {
            method: "POST",
            headers: {
                "Authorization": `Bearer ${token}`,
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                records: [
                    {
                        fields: {
                            Name: requestData.name,
                            Email: requestData.email,
                            Phone: requestData.phone,
                            County: requestData.county,
                            HouseholdSize: requestData.householdsize,
                            AssistanceType: requestData.assistanceType,
                            Description: requestData.description,
                            Urgency: requestData.urgency
                        }
                    }
                ]
            })
        }
    );

    const result = await response.json();

    console.log("Airtable status:", response.status);
    console.log("Airtable response:", result);

    if (!response.ok) {
        throw new Error(
            `Airtable error ${response.status}: ${JSON.stringify(result)}`
        );
    }

    return result;
}